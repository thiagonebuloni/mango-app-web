import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useMangoStore } from '../store/useStore';
import { Palette, Sun, Moon, Globe, Shield, User, Image } from 'lucide-react';
import { BottomNav } from '../components/BottomNav';

interface CorOpcao {
  nome: string;
  valor: string;
}

const CORES: CorOpcao[] = [
  { nome: 'Verde-água', valor: '#0E4F4A' },
  { nome: 'Azul', valor: '#1E3A5F' },
  { nome: 'Lilás', valor: '#3B2366' },
  { nome: 'Rosa', valor: '#6B1E3A' },
  { nome: 'Pêssego', valor: '#7A4A12' },
  { nome: 'Verde', valor: '#14532D' },
  { nome: 'Amarelo', valor: '#5C4A0E' },
  { nome: 'Cinza', valor: '#33393B' },
];

export function Perfil() {
  const navigate = useNavigate();
  const { perfil, salvarPerfil, seguranca, salvarSeguranca } = useMangoStore();

  const [temaClaro, setTemaClaro] = useState<boolean>(
    perfil?.temaClaro ?? false,
  );
  const [corSelecionada, setCorSelecionada] = useState<string>(
    perfil ? `#${perfil.corFundo.toString(16).padStart(6, '0')}` : CORES[0].valor,
  );
  const [idioma, setIdioma] = useState<'pt-BR' | 'en-US'>(
    perfil?.idioma ?? 'pt-BR',
  );
  const [username, setUsername] = useState<string>(perfil?.username ?? '');
  const [avatar, setAvatarBase64] = useState<string>(perfil?.avatar ?? '');
  const [pinAtivo, setPinAtivo] = useState<boolean>(
    seguranca?.pinAtivo ?? false,
  );
  const [bloqueioAtivo, setBloqueioAtivo] = useState<boolean>(
    seguranca?.bloqueioAtivo ?? false,
  );
  const [enviando, setEnviando] = useState<boolean>(false);

  const corAtiva = CORES.find((c) => c.valor === corSelecionada);

  const salvar = async () => {
    setEnviando(true);
    await salvarPerfil({
      temaClaro,
      corFundo: parseInt(corAtiva?.valor.replace('#', '') || '0e4f4a', 16),
      idioma,
      username,
      avatar,
    });
    await salvarSeguranca({
      pinAtivo,
      pinHash: seguranca?.pinHash,
      bloqueioAtivo,
    });
    setEnviando(false);
    navigate('/');
  };

  return (
    <div className="min-h-screen bg-background text-foreground p-4 sm:p-6">
      <div className="max-w-2xl mx-auto">
        <div className="flex items-center gap-4 mb-6">
          <button
            onClick={() => navigate('/')}
            className="px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 hover:bg-gray-700 text-sm"
          >
            Voltar
          </button>
          <h1 className="text-2xl font-bold">Perfil / Configurações</h1>
        </div>

        <div className="space-y-6">
          {/* Tema */}
          <div className="rounded-xl border border-gray-800 bg-gray-900/40 p-5">
            <div className="flex items-center justify-between mb-2">
              <label className="text-sm font-medium text-gray-300 flex items-center gap-2">
                <Palette className="w-4 h-4" />
                Tema
              </label>
              <button
                onClick={() => { setTemaClaro((v) => !v); const isLight = temaClaro; document.documentElement.classList.remove('light', 'dark'); document.documentElement.classList.add(isLight ? 'light' : 'dark'); document.body.classList.remove('light', 'dark'); document.body.classList.add(isLight ? 'light' : 'dark'); document.documentElement.style.colorScheme = isLight ? 'light' : 'dark'; document.body.style.colorScheme = isLight ? 'light' : 'dark'; }}
                className={`rounded-lg p-1.5 transition-colors ${
                  temaClaro
                    ? 'bg-gray-700 text-yellow-300 border border-yellow-500/30'
                    : 'bg-gray-800 text-blue-300 border border-blue-500/30'
                }`}
              >
                {temaClaro ? (
                  <Sun className="w-4 h-4" />
                ) : (
                  <Moon className="w-4 h-4" />
                )}
              </button>
            </div>
            <p className="text-xs text-gray-500">
              {temaClaro ? 'Tema claro' : 'Tema escuro'}
            </p>
          </div>
          {/* Username */}
          <div className="rounded-xl border border-gray-800 bg-gray-900/40 p-5">
            <div className="flex items-center justify-between mb-2">
              <label className="text-sm font-medium text-gray-300 flex items-center gap-2">
                <User className="w-4 h-4" /> Username
              </label>
            </div>
            <div className="flex items-center gap-2">
              <input
                type="text"
                value={username}
                onChange={(e) => setUsername(e.target.value)}
                className="flex-1 rounded bg-background border text-foreground px-3 py-2 focus:outline-none focus:border-blue-500"
                placeholder="Digite seu nome"
              />
            </div>
          </div>

          {/* Avatar */}
          <div className="rounded-xl border border-gray-800 bg-gray-900/40 p-5">
            <div className="flex items-center justify-between mb-2">
              <label className="text-sm font-medium text-gray-300 flex items-center gap-2">
                <Image className="w-4 h-4" /> Avatar
              </label>
            </div>
            <div className="flex flex-col items-center gap-4">
              {/* Emoticon option */}
              <div>
                <label className="flex flex-col items-center cursor-pointer select-none">
                  <input
                    type="radio"
                    name="avatar-type"
                    value="emoticon"
                    checked={!avatar || avatar === ''}
                    onChange={() => setAvatarBase64('')}
                    className="hidden"
                  />
                  <div
                    className="w-16 h-16 rounded-full flex items-center justify-center border-2 border-gray-700 bg-gray-800"
                    style={{ color: avatar ? '#FFD700' : '#888' }}
                  >
                    {avatar ? (
                      <img
                        src={"data:image/png;base64," + avatar}
                        alt="Avatar"
                        className="w-8 h-8 rounded-full object-cover"
                      />
                    ) : (
                      <div className="text-xl">👤</div>
                    )}
                  </div>
                  <p className="text-xs mt-1 text-gray-400">Emoticon/Upload</p>
                </label>
              </div>
              {/* Upload image */}
              <div>
                <label className="flex flex-col items-center cursor-pointer select-none">
                  <input
                    type="file"
                    accept="image/*"
                    onChange={(e) => {
                      const file = e.target.files?.[0];
                      if (file) {
                        const reader = new FileReader();
                        reader.onload = (event) => {
                          setAvatarBase64(
                            event.target?.result?.toString()?.split(',')[1] || ''
                          );
                        };
                        reader.readAsDataURL(file);
                      }
                    }}
                    className="hidden"
                  />
                  <div
                    className="w-16 h-16 rounded-full flex items-center justify-center border-2 border-indigo-500 bg-indigo-500/20"
                    onClick={() =>
                      document.querySelector('input[type="file"]')?.click()
                    }
                  >
                    <svg
                      className="w-6 h-6 text-indigo-400"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth={2}
                    >
                      <path d="M21 15a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h11m0 0L12 9l-3 3L9 5" />
                    </svg>
                    <input type="text" value="Upload" className="mt-1 text-xs text-gray-400" />
                  </div>
                  <p className="text-xs mt-1 text-gray-400">Selecionar imagem</p>
                </label>
              </div>
            </div>
          </div>


          </div>

          {/* Idioma */}
          <div className="rounded-xl border border-gray-800 bg-gray-900/40 p-5">
            <div className="flex items-center justify-between mb-2">
              <label className="text-sm font-medium text-gray-300 flex items-center gap-2">
                <Globe className="w-4 h-4" />
                Idioma
              </label>
            </div>
            <div className="flex gap-2">
              <button
                onClick={() => setIdioma('pt-BR')}
                className={`px-3 py-1.5 rounded text-sm transition-colors ${
                  idioma === 'pt-BR'
                    ? 'bg-blue-600 text-foreground'
                    : 'bg-gray-800 border border-gray-700 text-gray-300 hover:bg-gray-700'
                }`}
              >
                Português
              </button>
              <button
                onClick={() => setIdioma('en-US')}
                className={`px-3 py-1.5 rounded text-sm transition-colors ${
                  idioma === 'en-US'
                    ? 'bg-blue-600 text-foreground'
                    : 'bg-gray-800 border border-gray-700 text-gray-300 hover:bg-gray-700'
                }`}
              >
                English
              </button>
            </div>
          </div>

          {/* Segurança */}
          <div className="rounded-xl border border-gray-800 bg-gray-900/40 p-5">
            <div className="flex items-center gap-2 mb-3">
              <Shield className="w-4 h-4 text-gray-400" />
              <h2 className="text-sm font-medium text-gray-300">Segurança</h2>
            </div>
            <div className="flex items-center justify-between py-2">
              <span className="text-sm text-gray-300">PIN ativo</span>
              <button
                onClick={() => setPinAtivo((v) => !v)}
                className={`px-3 py-1.5 rounded text-sm transition-colors ${
                  pinAtivo
                    ? 'bg-blue-600 text-white'
                    : 'bg-gray-800 border border-gray-700 text-gray-300 hover:bg-gray-700'
                }`}
              >
                {pinAtivo ? 'Sim' : 'Não'}
              </button>
            </div>
            <div className="flex items-center justify-between py-2">
              <span className="text-sm text-gray-300">Bloqueio ativo</span>
              <button
                onClick={() => setBloqueioAtivo((v) => !v)}
                className={`px-3 py-1.5 rounded text-sm transition-colors ${
                  bloqueioAtivo
                    ? 'bg-blue-600 text-white'
                    : 'bg-gray-800 border border-gray-700 text-gray-300 hover:bg-gray-700'
                }`}
              >
                {bloqueioAtivo ? 'Sim' : 'Não'}
              </button>
            </div>
          </div>
        </div>

        <div className="mt-6">
          <button
            onClick={salvar}
            disabled={enviando}
            className="w-full py-3 rounded-lg bg-blue-600 hover:bg-blue-500 disabled:opacity-50 text-sm font-medium"
          >
            {enviando ? 'Salvando…' : 'Salvar configurações'}
          </button>
        </div>
      </div>
)}
export default Perfil;
